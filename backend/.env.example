PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/digital_warranty_tracker
JWT_SECRET=super_secret_jwt_key_for_digital_warranty_tracker_2026
JWT_EXPIRE=7d

# File Upload Configuration
# If Cloudinary credentials are provided, files will be stored in Cloudinary.
# If omitted or left as placeholder, files are securely stored locally in backend/uploads directory.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notifications (Optional - Nodemailer)
# If omitted, notifications are generated in-app without attempting SMTP transmission.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Digital Warranty Tracker" <notifications@warrantytracker.local>

# Cron Job Schedule (Default: Every day at 08:00 AM)
# Cron format: minute hour day-of-month month day-of-week
CRON_SCHEDULE=0 8 * * *
